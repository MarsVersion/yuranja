<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Prefer directory index files generated for crawlable routes
  DirectoryIndex index.html

  # If the request is not a file or directory, serve index.html (SPA fallback)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
