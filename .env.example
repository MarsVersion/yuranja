# Plausible Analytics (privacy-friendly, cookieless)
#
# Production — set in .env.production:
#   VITE_PLAUSIBLE_DOMAIN=yuranja.com
#
# Local verification (opt-in) — set in .env:
#   VITE_PLAUSIBLE_DOMAIN=yuranja.com
#   VITE_PLAUSIBLE_CAPTURE_LOCALHOST=true
#
# Without VITE_PLAUSIBLE_CAPTURE_LOCALHOST, analytics is disabled during
# `npm run dev` even if the domain is set.

VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_CAPTURE_LOCALHOST=
